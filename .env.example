# Copy this file to .env (in the project folder, next to Assets/) and fill in real values there.
# .env is in .gitignore and is never committed. This example file holds placeholders only.

# Password for the release signing key. "After Hours → Create release signing key" writes it here for you.
AFTERHOURS_KEY_PASSWORD=replace-with-your-key-password

# Optional: where the release key file is. Defaults to UserSettings/AfterHours-release.keystore.
# AFTERHOURS_KEYSTORE=UserSettings/AfterHours-release.keystore
